# Copy to deploy/.env and edit. Both compose files read it.
# Do not commit the result: .env is ignored by .gitignore.

# Image tag to run. Required, and deliberately has no default: a floating tag
# would let a restart move the deployment to a different build.
N0PASSTEMPS_VERSION=1.0.0

# Host port for the loopback publication of the HTTP listener. A TLS
# terminating reverse proxy is expected in front of it.
N0PASSTEMPS_HTTP_PORT=8080

# Path, relative to deploy/, of the config.toml produced by
# "make setup-wizard". Mounted read-only into the container.
N0PASSTEMPS_CONFIG_FILE=./config.toml

N0PASSTEMPS_LOGGING_LEVEL=info
N0PASSTEMPS_LOGGING_FORMAT=json

# Used by deploy/docker-compose.postgres.yml only. Generate the password with
# "openssl rand -base64 32" and keep it out of version control.
POSTGRES_USER=n0passtemps
POSTGRES_PASSWORD=replace-me-with-a-generated-password
POSTGRES_DB=n0passtemps

# Derives the lookup key from your application's user reference. Generate it
# with "n0passtemps-wizard pepper". Back it up with the keyring: losing it makes
# every existing subject unfindable.
N0PASSTEMPS_SUBJECT_PEPPER=
