# Install as /etc/n0passtemps/n0passtemps.env, owned by root, mode 0600: the
# database URL below carries a password, and EnvironmentFile is read by systemd
# as root before the service drops to the n0passtemps account.
#
#   install -o root -g root -m 0600 n0passtemps.env.example \
#       /etc/n0passtemps/n0passtemps.env

# The configuration path is not an environment variable. It is passed to the
# binary as -config in the unit file, because the file is read before any
# override could name it.

# Matches StateDirectory=n0passtemps in the unit, which is the only writable
# path the service has.
N0PASSTEMPS_DATABASE_DATA_DIR=/var/lib/n0passtemps

# Deliberately outside N0PASSTEMPS_DATABASE_DATA_DIR. The server refuses a keyring that
# resolves inside a configured data directory, because a key kept on the same
# volume as the ciphertext it protects is lost together with it in a stolen or
# restored backup. The file must be mode 0600 and owned by the service account;
# the server also refuses a keyring readable by group or other:
#
#   install -o n0passtemps -g n0passtemps -m 0600 keyring.json \
#       /etc/n0passtemps/kek/keyring.json
N0PASSTEMPS_KEK_PATH=/etc/n0passtemps/kek/keyring.json

# Loopback, with a reverse proxy in front terminating TLS. Binding a public
# interface here additionally needs either tls_cert_file and tls_key_file, or
# trust_proxy with trusted_proxy_cidrs.
N0PASSTEMPS_SERVER_ADDR=127.0.0.1:8080
N0PASSTEMPS_LOGGING_LEVEL=info
N0PASSTEMPS_LOGGING_FORMAT=json

# PostgreSQL deployments only. Leave unset to use the SQLite store under
# N0PASSTEMPS_DATABASE_DATA_DIR. sslmode=verify-full for anything not on localhost.
#N0PASSTEMPS_DATABASE_DSN=postgres://n0passtemps:CHANGE_ME@db.internal:5432/n0passtemps?sslmode=verify-full

# Derives the lookup key from the application's user reference. Generate it with
# "n0passtemps-wizard pepper" and back it up with the keyring. This file holds a
# secret, so install it mode 0600 owned by root; systemd reads it before
# dropping privileges.
N0PASSTEMPS_SUBJECT_PEPPER=

# Beside the keyring, outside the data directory.
N0PASSTEMPS_ASSERTION_SIGNING_KEY_PATH=/etc/n0passtemps/kek/assertion-key.pem
