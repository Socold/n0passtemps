# Secrets and per-environment settings for n0passtemps.
#
# Copy to .env and fill in. This file must never be committed: two of these
# values are secrets whose loss is unrecoverable.
#
# Every configuration key can be set here. Uppercase the dotted path from
# config.toml and prefix it with N0PASSTEMPS_, so webauthn.rp_id becomes
# N0PASSTEMPS_WEBAUTHN_RP_ID. The environment wins over the file.


# --- Required secrets -------------------------------------------------------

# Derives the lookup key from your application's user reference.
#
#   n0passtemps-wizard pepper
#
# Back it up. Losing it makes every existing subject unfindable, because the
# reference is not stored in clear and this is what turns one into a lookup key.
N0PASSTEMPS_SUBJECT_PEPPER=

# The key encryption keyring, when kek.provider is "env" rather than "file".
# Use this where an orchestrator injects secrets without mounting a file. The
# value is the same JSON document the file provider reads.
#
# The variable is unset by the process once read, so it does not remain visible
# to child processes or through /proc/self/environ.
# N0PASSTEMPS_KEK={"current":1,"keys":{"1":"..."}}


# --- Database ---------------------------------------------------------------

# A PostgreSQL DSN belongs here rather than in config.toml, because it carries
# a password.
#
# sslmode must be set explicitly. libpq defaults to "prefer", which falls back
# to an unencrypted connection without reporting it, so the validator refuses a
# DSN that leaves it unset. Use verify-full against anything that is not a
# loopback socket.
# N0PASSTEMPS_DATABASE_DSN=postgres://n0passtemps:CHANGE_ME@postgres:5432/n0passtemps?sslmode=verify-full


# --- Deployment -------------------------------------------------------------

# Pin the image. A moving tag makes a rollback impossible to describe.
N0PASSTEMPS_VERSION=1.1.0

# Where the container's port is published on the host. Keep it on loopback
# unless a reverse proxy in front terminates TLS.
N0PASSTEMPS_PUBLISH=127.0.0.1:8080

# The listener inside the container. It binds every interface because the
# container's network namespace is the boundary, not the bind address.
N0PASSTEMPS_SERVER_ADDR=0.0.0.0:8080


# --- Common overrides -------------------------------------------------------

# N0PASSTEMPS_WEBAUTHN_RP_ID=example.com
# N0PASSTEMPS_WEBAUTHN_ORIGINS=https://app.example.com
# N0PASSTEMPS_LOGGING_LEVEL=info
# N0PASSTEMPS_FEATURES_LITE_MODE=false

# Risk signals. The scalars only: the per-reason weight table is file-only,
# because the weights are the policy rather than a per-environment setting.
# See docs/RISK.md.
# N0PASSTEMPS_RISK_ENABLED=true
# N0PASSTEMPS_RISK_ELEVATED_AT=20
# N0PASSTEMPS_RISK_HIGH_AT=40
# N0PASSTEMPS_RISK_DORMANT_AFTER=2160h
# N0PASSTEMPS_RISK_NEW_CREDENTIAL_WITHIN=1h

# Accepted without the prefix as well, because the published quickstart uses
# the short form.
# LITE_MODE=true
